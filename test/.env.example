# ─── Target under test ────────────────────────────────────────────────────────
# Web app (Cloudflare Pages). Defaults to the production custom domain.
WEB_BASE_URL=https://hostelhub.mynilam.in

# REST API (Cloudflare Worker + D1). Tests seed and clean data through this.
API_BASE_URL=https://hostelhub.mynilamhousing.workers.dev

# ─── Test data ────────────────────────────────────────────────────────────────
# Every run creates its own throw-away owners, identified by this suffix.
TEST_EMAIL_DOMAIN=hostelhub.test
TEST_PASSWORD=Passw0rd!123

# ─── Mobile (Appium) ──────────────────────────────────────────────────────────
# Path to the built APK. Build with:
#   cd hostelhub && flutter build apk --release --dart-define=BACKEND=cloudflare
ANDROID_APP_PATH=../hostelhub/build/app/outputs/flutter-apk/app-release.apk
ANDROID_DEVICE_NAME=emulator-5554
ANDROID_PLATFORM_VERSION=14
APPIUM_HOST=127.0.0.1
APPIUM_PORT=4723

# Optional iOS target (needs a Mac + Xcode + WebDriverAgent)
IOS_APP_PATH=
IOS_DEVICE_NAME=iPhone 15
IOS_PLATFORM_VERSION=17.0

# ─── Behaviour ────────────────────────────────────────────────────────────────
# 1 lets Playwright retry a failing test once locally; CI uses 2.
RETRIES=0
# Keep 1 unless your test data is fully isolated per worker.
WORKERS=1
