{
  "name": "hostelhub-tests",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "HostelHub test automation — Playwright (web) + Appium/WebdriverIO (mobile) end-to-end, smoke and regression suites",
  "scripts": {
    "setup": "playwright install chromium",
    "test": "playwright test",
    "test:web": "playwright test e2e",
    "test:smoke": "playwright test smoketest",
    "test:regression": "playwright test regression",
    "test:mobile": "wdio run wdio.conf.js",
    "report": "playwright show-report reports/html",
    "testcases": "node test-cases/generate-test-cases.js",
    "cleanup:sql": "node test-cases/print-cleanup.js"
  },
  "dependencies": {
    "@playwright/test": "1.64.1",
    "dotenv": "^16.4.5",
    "exceljs": "^4.4.0"
  },
  "devDependencies": {
    "@wdio/appium-service": "^9.0.0",
    "@wdio/cli": "^9.0.0",
    "@wdio/local-runner": "^9.0.0",
    "@wdio/mocha-framework": "^9.0.0",
    "appium": "^2.11.0",
    "appium-uiautomator2-driver": "^3.7.0",
    "webdriverio": "^9.0.0"
  }
}
