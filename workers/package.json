{
  "name": "hostelhub-workers",
  "version": "1.0.0",
  "private": true,
  "description": "HostelHub backend — Cloudflare Workers + D1 (same REST API as server/)",
  "type": "module",
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "db:migrate:local": "wrangler d1 execute hostelhub --local --file=./schema.sql",
    "db:migrate:remote": "wrangler d1 execute hostelhub --remote --file=./schema.sql"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20260919.1",
    "typescript": "^5.6.0",
    "wrangler": "^4.135.0"
  }
}
